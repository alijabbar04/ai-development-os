{
  "name": "ai-dev-os",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first orchestration engine for collaborative AI software development.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:packed-consumer": "node packages/application/scripts/packed-consumer/verify-packed-consumer.mjs",
    "verify:intake-packed-consumer": "npm run verify:packed-consumer --workspace @ai-dev-os/intake",
    "verify:app-vault-packed-consumer": "node packages/secrets-app-vault/scripts/packed-consumer/verify-packed-consumer.mjs",
    "verify:app-vault-electron-smoke": "npm --prefix apps/credential-setup run ensure:electron && npm run smoke:real --workspace @ai-dev-os/secrets-app-vault-electron",
    "verify:windows-native-shape": "node apps/credential-setup/scripts/verify-windows-credential-addon-shape.mjs",
    "verify:credential-host-electron-smoke": "npm run smoke:real --workspace @ai-dev-os/credential-setup",
    "regenerate:credential-host-evidence-screenshot": "npm run regenerate:evidence-screenshot --workspace @ai-dev-os/credential-setup",
    "generate:stage-18e-h-subject-manifest": "node scripts/generate-stage-18e-h-subject-manifest.mjs",
    "verify:stage-18e-h-subject-manifest": "node scripts/verify-stage-18e-h-subject-manifest.mjs",
    "generate:stage-18e-i-subject-manifest": "node scripts/generate-stage-18e-i-subject-manifest.mjs",
    "verify:stage-18e-i-subject-manifest": "node scripts/verify-stage-18e-i-subject-manifest.mjs",
    "verify:stage-18e-i-if-published": "node scripts/verify-stage-18e-i-if-published.mjs",
    "verify:credential-host-packed": "npm run verify:packed --workspace @ai-dev-os/credential-setup"
  },
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "node-gyp": "12.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
