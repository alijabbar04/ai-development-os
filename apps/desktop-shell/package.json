{
  "name": "@ai-dev-os/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Development-only Windows Electron workspace for AI Development OS.",
  "type": "module",
  "main": "dist/main/startup.js",
  "scripts": {
    "prebuild": "npm --prefix ../../packages/control-service run build && npm --prefix ../../packages/project run build && npm --prefix ../../packages/plan run build",
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "prestart": "npm run build",
    "start": "node scripts/launch-desktop.mjs",
    "presmoke:real": "npm run build",
    "smoke:real": "node scripts/real-electron-smoke.mjs"
  },
  "dependencies": {
    "@ai-dev-os/control-service": "0.1.0"
  },
  "devDependencies": {
    "@ai-dev-os/plan": "^0.1.0",
    "@ai-dev-os/project": "^0.1.0",
    "electron": "43.4.1"
  },
  "peerDependencies": {
    "electron": "43.4.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
