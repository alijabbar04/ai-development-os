{
  "name": "@ai-dev-os/provider-gemini",
  "version": "0.1.0",
  "private": true,
  "description": "Native bounded Gemini generateContent and streamGenerateContent adapter.",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "!dist/**/*.test.*", "!dist/live"],
  "scripts": {
    "prebuild": "npm --prefix ../provider-catalog run build && npm --prefix ../policy run build && npm --prefix ../secrets run build && npm --prefix ../providers run build",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run prebuild", "test": "vitest run",
    "pretest:coverage": "npm run prebuild", "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run prebuild", "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:live:gemini": "vitest run --config vitest.live.config.ts src/live/gemini.live.test.ts"
  },
  "dependencies": {
    "@ai-dev-os/domain": "^0.1.0", "@ai-dev-os/policy": "^0.1.0", "@ai-dev-os/provider-catalog": "^0.1.0", "@ai-dev-os/providers": "^0.1.0", "@ai-dev-os/secrets": "^0.1.0"
  }
}
