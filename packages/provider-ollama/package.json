{
  "name": "@ai-dev-os/provider-ollama",
  "version": "0.1.0",
  "private": true,
  "description": "Native Ollama inference adapter and local capacity manager for AI Development OS: loopback-only transport, bounded NDJSON streaming, digest-validated model catalog, capability-aware local selection, and deterministic capacity admission.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../providers run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../provider-testkit run build",
    "test": "vitest run",
    "pretest:coverage": "npm --prefix ../provider-testkit run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm --prefix ../provider-testkit run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/domain": "^0.1.0",
    "@ai-dev-os/providers": "^0.1.0"
  },
  "devDependencies": {
    "@ai-dev-os/provider-testkit": "^0.1.0"
  }
}
