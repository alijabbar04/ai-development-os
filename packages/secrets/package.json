{
  "name": "@ai-dev-os/secrets",
  "version": "0.1.0",
  "private": true,
  "description": "Secret references, scoped material, broker ports, safe audits, policy-aware composition, and reusable broker contracts for AI Development OS.",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./testing": { "types": "./dist/testing/contract-suite.d.ts", "import": "./dist/testing/contract-suite.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "prebuild": "npm --prefix ../policy run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../policy run build",
    "test": "vitest run",
    "pretest:coverage": "npm --prefix ../policy run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm --prefix ../policy run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/domain": "^0.1.0",
    "@ai-dev-os/policy": "^0.1.0",
    "@ai-dev-os/providers": "^0.1.0"
  },
  "peerDependencies": { "vitest": ">=4.0.0" },
  "peerDependenciesMeta": { "vitest": { "optional": true } }
}
