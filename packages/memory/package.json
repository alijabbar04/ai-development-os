{
  "name": "@ai-dev-os/memory",
  "version": "0.1.0",
  "private": true,
  "description": "Durable-port, provenance-aware, scope-isolated memory records for AI Development OS: facts, decisions, summaries, preferences, and unconfirmed candidates.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/contract-suite.d.ts",
      "import": "./dist/testing/contract-suite.js"
    },
    "./testing/fixtures": {
      "types": "./dist/testing/fixtures.d.ts",
      "import": "./dist/testing/fixtures.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../artifacts run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../artifacts run build",
    "test": "vitest run",
    "pretest:coverage": "npm --prefix ../artifacts run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm --prefix ../artifacts run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/artifacts": "^0.1.0",
    "@ai-dev-os/domain": "^0.1.0"
  },
  "peerDependencies": { "vitest": ">=4.0.0" },
  "peerDependenciesMeta": { "vitest": { "optional": true } }
}
