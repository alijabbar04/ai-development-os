{
  "name": "@ai-dev-os/application",
  "version": "0.1.0",
  "private": true,
  "description": "Production-disabled Windows-local application composition and exact-pinned normalized usage boundaries for AI Development OS.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./planning-storage": {
      "types": "./dist/planning-storage.d.ts",
      "import": "./dist/planning-storage.js"
    },
    "./planning-contracts": {
      "types": "./dist/planning-contracts.d.ts",
      "import": "./dist/planning-contracts.js"
    },
    "./planning": {
      "types": "./dist/planning.d.ts",
      "import": "./dist/planning.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../scheduler run build && npm --prefix ../persistence-sqlite run build && npm --prefix ../persistence-postgres run build && npm --prefix ../plan run build && npm --prefix ../approval run build && npm --prefix ../provider-claude-code run build && npm --prefix ../thinker run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build && npm --prefix ../persistence-memory run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build && npm --prefix ../persistence-memory run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/config": "^0.1.0",
    "@ai-dev-os/context": "^0.1.0",
    "@ai-dev-os/policy": "^0.1.0",
    "@ai-dev-os/providers": "^0.1.0",
    "@ai-dev-os/provider-claude-code": "^0.1.0",
    "@ai-dev-os/prompt-compiler": "^0.1.0",
    "@ai-dev-os/thinker": "^0.1.0",
    "@ai-dev-os/domain": "^0.1.0",
    "@ai-dev-os/persistence": "^0.1.0",
    "@ai-dev-os/persistence-postgres": "^0.1.0",
    "@ai-dev-os/persistence-sqlite": "^0.1.0",
    "@ai-dev-os/scheduler": "^0.1.0",
    "@ai-dev-os/project": "^0.1.0",
    "@ai-dev-os/intake": "^0.1.0",
    "@ai-dev-os/plan": "^0.1.0",
    "@ai-dev-os/approval": "^0.1.0"
  },
  "devDependencies": {
    "@ai-dev-os/persistence-memory": "^0.1.0",
    "@types/pg": "8.21.0",
    "pg": "8.23.0"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
