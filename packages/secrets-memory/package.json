{
  "name": "@ai-dev-os/secrets-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic in-memory reference secret broker for AI Development OS.",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "prebuild": "npm --prefix ../secrets run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../secrets run build",
    "test": "vitest run",
    "pretest:coverage": "npm --prefix ../secrets run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm --prefix ../secrets run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@ai-dev-os/secrets": "^0.1.0" }
}
