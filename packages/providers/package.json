{
  "name": "@ai-dev-os/providers",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral inference and coding-agent contracts for AI Development OS: requests, events, results, capabilities, errors, retry taxonomy, operation machinery, and reusable contract suites.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/contract-suite.d.ts",
      "import": "./dist/testing/contract-suite.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../artifacts run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../artifacts run build",
    "test": "vitest run",
    "pretest:coverage": "npm --prefix ../artifacts run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm --prefix ../artifacts run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/artifacts": "^0.1.0",
    "@ai-dev-os/domain": "^0.1.0"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
