{
  "name": "@ai-dev-os/policy",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral central policy broker, approval evidence, deterministic decisions, and safe audit contracts for AI Development OS.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/contract-suite.d.ts",
      "import": "./dist/testing/contract-suite.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "prebuild": "npm --prefix ../providers run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm --prefix ../providers run build",
    "test": "vitest run",
    "pretest:coverage": "npm --prefix ../providers run build",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm --prefix ../providers run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/domain": "^0.1.0",
    "@ai-dev-os/providers": "^0.1.0"
  },
  "peerDependencies": { "vitest": ">=4.0.0" },
  "peerDependenciesMeta": { "vitest": { "optional": true } }
}
