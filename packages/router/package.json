{
  "name": "@ai-dev-os/router",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic hard-constrained quota-aware routing without invocation authority.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/contract-suite.d.ts",
      "import": "./dist/testing/contract-suite.js"
    },
    "./testing/fixtures": {
      "types": "./dist/testing/fixtures.d.ts",
      "import": "./dist/testing/fixtures.js"
    }
  },
  "files": [
    "dist",
    "goldens",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../config run build && npm --prefix ../policy run build && npm --prefix ../provider-catalog run build && npm --prefix ../provider-gateway run build && npm --prefix ../telemetry-ledger run build && npm --prefix ../profiler run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run prebuild",
    "test": "vitest run",
    "pretest:coverage": "npm run prebuild",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "goldens:update": "npm run build && node scripts/update-goldens.mjs --approve"
  },
  "dependencies": {
    "@ai-dev-os/config": "^0.1.0",
    "@ai-dev-os/domain": "^0.1.0",
    "@ai-dev-os/policy": "^0.1.0",
    "@ai-dev-os/profiler": "^0.1.0",
    "@ai-dev-os/provider-catalog": "^0.1.0",
    "@ai-dev-os/provider-gateway": "^0.1.0",
    "@ai-dev-os/providers": "^0.1.0",
    "@ai-dev-os/telemetry-ledger": "^0.1.0"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
