{
  "name": "@ai-dev-os/secrets-app-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Pure application-owned encrypted vault broker for AI Development OS.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../domain run build && npm --prefix ../providers run build && npm --prefix ../policy run build && npm --prefix ../secrets run build",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run prebuild",
    "test": "vitest run",
    "pretest:coverage": "npm run prebuild",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-dev-os/domain": "^0.1.0",
    "@ai-dev-os/secrets": "^0.1.0"
  }
}
